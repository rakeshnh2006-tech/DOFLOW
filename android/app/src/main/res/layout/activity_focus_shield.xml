<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#121315">

    <TextView
        android:id="@+id/tv_shield_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="54sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_shield_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doflow Focus Lock"
        android:textColor="#F4F3F0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_shield_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deep Work Session in Progress"
        android:textColor="#E8590C"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_shield_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00 remaining"
        android:textColor="#9DA0A8"
        android:textSize="15sp"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/tv_shield_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This application is temporarily restricted to protect your attention and keep you in deep flow."
        android:textColor="#6C7079"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btn_return_doflow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Return to Doflow"
        android:textColor="#FFFFFF"
        android:background="#E8590C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_end_early"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="End Focus Session Early"
        android:textColor="#9DA0A8"
        android:background="#1B1D20"
        android:textSize="14sp" />

</LinearLayout>
