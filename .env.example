# ==============================================================================
# Doflow Environment Configuration
# ==============================================================================
# Google Cloud Console OAuth 2.0 Web Client ID
#
# Steps to obtain your Client ID:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create or select a project (e.g. "Doflow")
# 3. Configure the OAuth Consent Screen (External / User Support Email)
# 4. Under Credentials, click "+ CREATE CREDENTIALS" -> "OAuth client ID"
# 5. Application type: "Web application"
# 6. Authorized JavaScript origins:
#      - http://localhost:5173
#      - http://127.0.0.1:5173
# 7. Copy your Client ID and paste it below:
# ==============================================================================

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
